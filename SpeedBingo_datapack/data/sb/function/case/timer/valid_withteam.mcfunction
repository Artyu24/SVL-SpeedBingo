$execute as @e[type=minecraft:marker,tag=$(caseName),tag=$(teamLose)Win,limit=1] run function sb:case/case_validation {teamWin:"$(teamWin)", teamLose:"$(teamLose)", caseName:"$(caseName)", colorBlock:"$(colorBlock)", colorText:"$(colorText)"}
$scoreboard players operation #$(caseName) BingoTimer_Saved = @p[distance=..25, gamemode=adventure, team=$(teamWin)] BingoTimer_Second
$execute as @e[type=minecraft:marker,tag=$(caseName),tag=$(teamWin)Win,limit=1] at @s run data modify entity @e[type=minecraft:text_display,tag=TextScore_$(caseName),distance=..10,sort=nearest,limit=1] text set value [{score:{name:"#$(caseName)",objective:"BingoTimer_Saved"},color:"$(colorText)"},{text:"s",color:"$(colorText)"}]
$tellraw @a[distance=..200] [{color:"gray",text:"["},{color:"#fffb00",text:"S"},{color:"#fff100",text:"p"},{color:"#ffe700",text:"e"},{color:"#ffdc00",text:"e"},{color:"#ffd200",text:"d "},{color:"#ffbe00",text:"B"},{color:"#ffb400",text:"i"},{color:"#ffa900",text:"n"},{color:"#ff9f00",text:"g"},{color:"#ff9500",text:"o"},{color:"gray",text:"]"},{color:"gray",text:" - "},{color:"gray",text:"[$(caseName)]"},{color:"gray",text:" - "},{selector:"@p[distance=..25,gamemode=adventure,team=$(teamWin)]",color:"$(colorText)"}," améliore le meilleur temps de l'équipe ",{color:"$(colorText)",text:"$(teamWin)"}," !"] 
return 1