$execute if score #$(teamA) BingoValid_MM matches 1 if score #$(teamB) BingoValid_MM matches 0 run function sb:case/case_validation {teamWin:"$(teamA)",teamLose:"$(teamB)",caseName:"$(caseName)",color:"$(colorA)"}
$execute if score #$(teamB) BingoValid_MM matches 1 if score #$(teamA) BingoValid_MM matches 0 run function sb:case/case_validation {teamWin:"$(teamB)",teamLose:"$(teamA)",caseName:"$(caseName)",color:"$(colorB)"}
$execute if score #$(teamA) BingoValid_MM matches 1 if score #$(teamB) BingoValid_MM matches 1 if score #Mastermind_$(teamA) BingoTime < #Mastermind_$(teamB) BingoTime run function sb:case/case_validation {teamWin:"$(teamA)",teamLose:"$(teamB)",caseName:"$(caseName)",color:"$(colorA)"}
$execute if score #$(teamA) BingoValid_MM matches 1 if score #$(teamB) BingoValid_MM matches 1 if score #Mastermind_$(teamB) BingoTime < #Mastermind_$(teamA) BingoTime run function sb:case/case_validation {teamWin:"$(teamB)",teamLose:"$(teamA)",caseName:"$(caseName)",color:"$(colorB)"}
$execute if score #$(teamA) BingoValid_MM matches 0 if score #$(teamB) BingoValid_MM matches 0 run tellraw @a {"text":"Aucune equipe n'a trouve le Mastermind.","color":"red"}
$execute if score #$(teamA) BingoValid_MM matches 1 if score #$(teamB) BingoValid_MM matches 1 if score #Mastermind_$(teamA) BingoTime = #Mastermind_$(teamB) BingoTime run tellraw @a {"text":"Egalite parfaite au Mastermind.","color":"yellow"}
