# Conserve le composant avant de vider le baril afin de pouvoir diagnostiquer un format inconnu.
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Barrel,limit=1] run data modify storage sb:tetes $(instance).last_name set from block ~ ~ ~ Items[{id:"minecraft:paper"}].components."minecraft:custom_name"

# Accepte les serialisations produites par les differentes versions de l'enclume.
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Barrel,limit=1] if data block ~ ~ ~ Items[{id:"minecraft:paper",components:{"minecraft:custom_name":"$(answer)"}}] run return run function sb:module/tetes/finish_correct {instance:"$(instance)",teamName:"$(teamName)",teamColorBlock:"$(teamColorBlock)",teamColorText:"$(teamColorText)",enemyTeam:"$(enemyTeam)",caseName:"$(caseName)"}
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Barrel,limit=1] if data block ~ ~ ~ Items[{id:"minecraft:paper",components:{"minecraft:custom_name":"Seize"}}] run return run function sb:module/tetes/finish_correct {instance:"$(instance)",teamName:"$(teamName)",teamColorBlock:"$(teamColorBlock)",teamColorText:"$(teamColorText)",enemyTeam:"$(enemyTeam)",caseName:"$(caseName)"}
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Barrel,limit=1] if data block ~ ~ ~ Items[{id:"minecraft:paper",components:{"minecraft:custom_name":"seize"}}] run return run function sb:module/tetes/finish_correct {instance:"$(instance)",teamName:"$(teamName)",teamColorBlock:"$(teamColorBlock)",teamColorText:"$(teamColorText)",enemyTeam:"$(enemyTeam)",caseName:"$(caseName)"}
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Barrel,limit=1] if data block ~ ~ ~ Items[{id:"minecraft:paper",components:{"minecraft:custom_name":{text:"$(answer)"}}}] run return run function sb:module/tetes/finish_correct {instance:"$(instance)",teamName:"$(teamName)",teamColorBlock:"$(teamColorBlock)",teamColorText:"$(teamColorText)",enemyTeam:"$(enemyTeam)",caseName:"$(caseName)"}
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Barrel,limit=1] if items block ~ ~ ~ container.* minecraft:paper[minecraft:custom_name='"$(answer)"'] run return run function sb:module/tetes/finish_correct {instance:"$(instance)",teamName:"$(teamName)",teamColorBlock:"$(teamColorBlock)",teamColorText:"$(teamColorText)",enemyTeam:"$(enemyTeam)",caseName:"$(caseName)"}
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Barrel,limit=1] if items block ~ ~ ~ container.* minecraft:paper[minecraft:custom_name='{"text":"$(answer)"}'] run return run function sb:module/tetes/finish_correct {instance:"$(instance)",teamName:"$(teamName)",teamColorBlock:"$(teamColorBlock)",teamColorText:"$(teamColorText)",enemyTeam:"$(enemyTeam)",caseName:"$(caseName)"}
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Barrel,limit=1] if items block ~ ~ ~ container.* minecraft:paper[minecraft:custom_name='{"text":"$(answer)","italic":false}'] run return run function sb:module/tetes/finish_correct {instance:"$(instance)",teamName:"$(teamName)",teamColorBlock:"$(teamColorBlock)",teamColorText:"$(teamColorText)",enemyTeam:"$(enemyTeam)",caseName:"$(caseName)"}
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Barrel,limit=1] if items block ~ ~ ~ container.* minecraft:paper[minecraft:custom_name='{"italic":false,"text":"$(answer)"}'] run return run function sb:module/tetes/finish_correct {instance:"$(instance)",teamName:"$(teamName)",teamColorBlock:"$(teamColorBlock)",teamColorText:"$(teamColorText)",enemyTeam:"$(enemyTeam)",caseName:"$(caseName)"}

