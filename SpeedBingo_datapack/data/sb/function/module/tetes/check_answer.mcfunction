$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Barrel,limit=1] if data block ~ ~ ~ Items[{id:"minecraft:paper",components:{"minecraft:custom_name":'{"italic":false,"text":"$(answer)"}'}}] run return run function sb:module/tetes/finish_correct {instance:"$(instance)",teamName:"$(teamName)",teamColorBlock:"$(teamColorBlock)",teamColorText:"$(teamColorText)",enemyTeam:"$(enemyTeam)",caseName:"$(caseName)"}
