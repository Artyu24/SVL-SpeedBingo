# Ouvre uniquement le mur noir. Les quatre directions rendent la fonction compatible avec //rotate.
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] positioned ~ ~7 ~27 if entity @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall2,distance=..1.5,limit=1] at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] run fill ~ ~ ~ ~ ~7 ~27 minecraft:air replace minecraft:black_concrete
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] positioned ~ ~7 ~-27 if entity @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall2,distance=..1.5,limit=1] at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] run fill ~ ~ ~ ~ ~7 ~-27 minecraft:air replace minecraft:black_concrete
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] positioned ~27 ~7 ~ if entity @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall2,distance=..1.5,limit=1] at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] run fill ~ ~ ~ ~27 ~7 ~ minecraft:air replace minecraft:black_concrete
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] positioned ~-27 ~7 ~ if entity @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall2,distance=..1.5,limit=1] at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] run fill ~ ~ ~ ~-27 ~7 ~ minecraft:air replace minecraft:black_concrete
