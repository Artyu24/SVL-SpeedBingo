# Reconstruit le rectangle defini par Wall1 et Wall2, quelle que soit la rotation de la schematic.
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] positioned ~ ~7 ~27 if entity @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall2,distance=..1.5,limit=1] at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] run fill ~ ~ ~ ~ ~7 ~27 minecraft:black_concrete
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] positioned ~ ~7 ~-27 if entity @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall2,distance=..1.5,limit=1] at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] run fill ~ ~ ~ ~ ~7 ~-27 minecraft:black_concrete
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] positioned ~27 ~7 ~ if entity @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall2,distance=..1.5,limit=1] at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] run fill ~ ~ ~ ~27 ~7 ~ minecraft:black_concrete
$execute at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] positioned ~-27 ~7 ~ if entity @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall2,distance=..1.5,limit=1] at @e[type=minecraft:marker,tag=BingoTetes_$(instance)_Wall1,limit=1] run fill ~ ~ ~ ~-27 ~7 ~ minecraft:black_concrete
