# Instance A pour Albertos, instance B pour RTT.
$function sb:module/craft/instance_tick {instance:"A",teamName:"$(teamA)",teamColorBlock:"light_blue",teamColorText:"aqua",enemyTeam:"$(teamB)",enemyColorBlock:"lime",enemyColorText:"green",caseName:"$(caseName)"}
$function sb:module/craft/instance_tick {instance:"B",teamName:"$(teamB)",teamColorBlock:"lime",teamColorText:"green",enemyTeam:"$(teamA)",enemyColorBlock:"light_blue",enemyColorText:"aqua",caseName:"$(caseName)"}
